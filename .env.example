# Copy to .env.local. Keys stay on the server. Restart the app after configuring.
# This shared template has no credentials. Mock works without local configuration.
ADORA_AI_API_KEY=
ADORA_AI_BASE_URL=
ADORA_AI_MODEL=
ADORA_AI_PROVIDER=
# Use a HTTPS base URL supporting POST /chat/completions and JSON object output.
# DeepSeek official base URL: https://api.deepseek.com
# Select a current model supported by your account; no model is assumed here.
# Xiaomi MiMo: ADORA_AI_BASE_URL=https://api.xiaomimimo.com/v1
# ADORA_AI_MODEL=mimo-v2.6-flash, ADORA_AI_PROVIDER=Xiaomi MiMo
# The official MiMo endpoint uses api-key authentication and disabled thinking.
